<Project>
  <PropertyGroup>
    <Version>1.1.0</Version>
    <!-- Last successful package revision, incremented only by Package.ps1 -->
    <BuildRevision>19</BuildRevision>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).$(BuildRevision)</FileVersion>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Win10 Explorer Kit</Product>
    <!-- Publisher name shared by application file metadata and the installer -->
    <Company>Win10 Explorer Kit</Company>
    <Copyright>Copyright (c) 2026 Win10 Explorer Kit</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
