<!-- Groups existing principals and custom rights without changing the application's Fluent controls -->
<UserControl x:Class="Win10ExplorerKit.UI.Views.Dialogs.CustomPermissionsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:s="clr-namespace:Win10ExplorerKit.UI.Services" Width="520">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="OperationSegment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,4"/>
   <Setter Property="Background" Value="{DynamicResource KitSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource KitBorderBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="SegmentSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
      CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="Grid.Column" Value="1"><Setter TargetName="SegmentSurface" Property="CornerRadius" Value="0,6,6,0"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource KitAccentSoftBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter Property="Background" Value="{DynamicResource KitAccentSoftBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource KitAccentTextBrush}"/><Setter Property="Panel.ZIndex" Value="1"/>
       <Setter Property="Foreground" Value="{DynamicResource KitAccentTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource KitAccentSoftBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource KitAccentTextBrush}"/><Setter Property="Panel.ZIndex" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding [permissions.principals], Source={x:Static s:LocalizedText.Instance}}" Style="{StaticResource SectionLabel}"/>
   <DockPanel Margin="0,0,0,8">
    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <s:SelectAllCheckBox Style="{StaticResource {x:Type CheckBox}}" IsThreeState="True" Cursor="Hand" Content="{Binding [permissions.selectAll], Source={x:Static s:LocalizedText.Instance}}" IsChecked="{Binding AllSelected, Mode=TwoWay}"
     IsEnabled="{Binding HasPrincipals}" HorizontalAlignment="Left"/>
   </DockPanel>
   <Border Background="{DynamicResource KitSurfaceBrush}" BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
    <ListBox ItemsSource="{Binding Principals}" Height="180" Background="Transparent" BorderThickness="0"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
     AutomationProperties.Name="{Binding [permissions.principals], Source={x:Static s:LocalizedText.Instance}}">
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
       <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="4,2"/></ControlTemplate></Setter.Value></Setter>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <CheckBox Cursor="Hand" IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Padding="0,4" AutomationProperties.Name="{Binding Label}">
        <CheckBox.ToolTip><StackPanel><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Sid}"/></StackPanel></CheckBox.ToolTip>
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
       </CheckBox>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </Border>
  </StackPanel>
  <StackPanel Grid.Column="2">
   <TextBlock Text="{Binding [permissions.operation], Source={x:Static s:LocalizedText.Instance}}" Style="{StaticResource SectionLabel}"/>
    <Grid KeyboardNavigation.TabNavigation="Once" Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <RadioButton Style="{StaticResource OperationSegment}" GroupName="PermissionOperation"
      Content="{Binding [permissions.grant], Source={x:Static s:LocalizedText.Instance}}" IsChecked="{Binding IsAllow, Mode=TwoWay}"/>
     <RadioButton Grid.Column="1" Style="{StaticResource OperationSegment}" GroupName="PermissionOperation"
      Content="{Binding [permissions.reject], Source={x:Static s:LocalizedText.Instance}}" IsChecked="{Binding IsDeny, Mode=TwoWay}" Margin="-1,0,0,0"/>
    </Grid>
   <s:SelectAllCheckBox Style="{StaticResource {x:Type CheckBox}}" Cursor="Hand" IsThreeState="True" FontWeight="SemiBold"
    HorizontalAlignment="Left" MinWidth="0" Margin="0,0,0,8"
    Content="{Binding [permissions.rights], Source={x:Static s:LocalizedText.Instance}}" IsChecked="{Binding AllRightsSelected, Mode=TwoWay}"/>
   <ItemsControl ItemsSource="{Binding Rights}">
    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Cursor="Hand" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}">
   <ProgressBar Height="3" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
  </StackPanel>
 </Grid>
</UserControl>
