<Page x:Class="Win10ExplorerKit.UI.Views.Pages.HashPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:s="clr-namespace:Win10ExplorerKit.UI.Services" ScrollViewer.CanContentScroll="False" AllowDrop="True" DragOver="DragOverFiles" Drop="DropFiles" Background="Transparent">
 <Page.Resources>
  <Style x:Key="HashValueCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
   <Setter Property="Cursor" Value="{Binding CanCopy, Converter={StaticResource HashCursorConverter}}"/>
   <Setter Property="ToolTip" Value="{Binding [hash.clickToCopy], Source={x:Static s:LocalizedText.Instance}}"/>
   <Setter Property="ToolTipService.IsEnabled" Value="{Binding CanCopy}"/>
   <EventSetter Event="PreviewMouseLeftButtonUp" Handler="CopyValue"/>
  </Style>
  <Style x:Key="HashRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="DataGridRow">
     <Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
      <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource KitAccentSoftBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </Page.Resources>
 <Border Background="{DynamicResource KitSurfaceBrush}" BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12">
 <Grid Margin="24,16,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding [hash.title], Source={x:Static s:LocalizedText.Instance}}" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1" Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="104"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding [hash.algorithm], Source={x:Static s:LocalizedText.Instance}}" Margin="0,0,0,6"/>
   <TextBlock Grid.Column="1" Text="{Binding [hash.parallelism], Source={x:Static s:LocalizedText.Instance}}" Margin="0,0,0,6"/>
   <TextBlock Grid.Column="2" Text="{Binding [hash.folderDepth], Source={x:Static s:LocalizedText.Instance}}" Margin="0,0,0,6"/>
   <ComboBox Cursor="Hand" x:Name="Algorithm" Grid.Row="1" Width="140" VerticalAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm, Mode=OneWay}" IsEnabled="{Binding CanChangeAlgorithm}" SelectionChanged="AlgorithmChanged"/>
   <ComboBox Cursor="Hand" x:Name="Parallelism" Grid.Row="1" Grid.Column="1" Width="88" VerticalAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding ParallelOptions}" SelectedItem="{Binding Parallelism, Mode=OneWay}" IsEnabled="{Binding CanChangeParallelism}" SelectionChanged="ParallelismChanged"/>
   <ComboBox Cursor="Hand" x:Name="FolderDepth" Grid.Row="1" Grid.Column="2" Width="96" VerticalAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding FolderDepthOptions}" SelectedItem="{Binding FolderDepth, Mode=OneWay}" IsEnabled="{Binding CanChangeParallelism}" SelectionChanged="FolderDepthChanged">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource FolderDepthConverter}"><Binding/><Binding Path="[hash.allDepths]" Source="{x:Static s:LocalizedText.Instance}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <ui:Button Cursor="Hand" x:Name="AddFilesButton" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Content="{Binding [hash.addFiles], Source={x:Static s:LocalizedText.Instance}}" Click="AddFiles" Appearance="Primary"/>
  </Grid>
  <Grid Grid.Row="2">
  <DataGrid x:Name="Results" ItemsSource="{Binding Rows}" Background="{DynamicResource KitSurfaceBrush}" BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="1" ColumnHeaderStyle="{StaticResource HashHeaderStyle}" RowStyle="{StaticResource HashRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="34" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="CopyKey">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="200" MinWidth="120">
     <DataGridTemplateColumn.Header><TextBlock Text="{Binding [hash.file], Source={x:Static s:LocalizedText.Instance}}"/></DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" ToolTipOpening="FileNameToolTipOpening"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn x:Name="HashValueColumn" Width="*" MinWidth="180" CellStyle="{StaticResource HashValueCellStyle}">
     <DataGridTemplateColumn.Header><TextBlock Text="{Binding [hash.value], Source={x:Static s:LocalizedText.Instance}}"/></DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
   <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0" IsHitTestVisible="False">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="32" Foreground="{DynamicResource KitAccentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding [hash.emptyHint], Source={x:Static s:LocalizedText.Instance}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Progress is computed by the model and must never receive control values -->
   <ProgressBar Height="3" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource KitAccentTextBrush}" Background="{DynamicResource KitAccentSoftBrush}" Margin="0,0,0,12"/>
   <DockPanel Grid.Row="1" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <ui:Button Cursor="Hand" Content="{Binding CopyAllLabel}" IsEnabled="{Binding CanCopyAll}" Click="CopyAll" Appearance="Primary" Margin="8,0,0,0"/>
     <ui:Button Cursor="Hand" Content="{Binding [hash.cancel], Source={x:Static s:LocalizedText.Instance}}" IsEnabled="{Binding IsBusy}" Click="Cancel" Margin="8,0,0,0"/>
     <ui:Button Cursor="Hand" Content="{Binding [hash.clear], Source={x:Static s:LocalizedText.Instance}}" IsEnabled="{Binding CanClear}" Click="Clear" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock AutomationProperties.AutomationId="HashSummary" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Grid>
 </Grid>
 </Border>
</Page>
