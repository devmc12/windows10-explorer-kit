<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:s="clr-namespace:Win10ExplorerKit.UI.Services" x:Class="Win10ExplorerKit.UI.Views.Pages.SettingsPage" ScrollViewer.CanContentScroll="False" Background="Transparent">
 <Border Background="{DynamicResource KitSurfaceBrush}" BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24,16,24,20">
   <TextBlock Text="{Binding [settings.title], Source={x:Static s:LocalizedText.Instance}}" Style="{StaticResource PageTitle}"/>
   <Grid Style="{StaticResource SettingRow}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding [settings.language], Source={x:Static s:LocalizedText.Instance}}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    <ComboBox Cursor="Hand" Grid.Column="1" Width="180" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}">
     <ComboBox.ItemTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding Converter={StaticResource LanguageNameConverter}}"/>
      </DataTemplate>
     </ComboBox.ItemTemplate>
    </ComboBox>
   </Grid>
   <Grid Style="{StaticResource SettingRow}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding [settings.theme], Source={x:Static s:LocalizedText.Instance}}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    <ComboBox Cursor="Hand" Grid.Column="1" Width="180" VerticalAlignment="Center" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
     <ComboBox.ItemTemplate>
      <DataTemplate>
       <TextBlock>
        <TextBlock.Text>
         <MultiBinding Converter="{StaticResource ThemeNameConverter}">
          <Binding/>
          <Binding Path="[settings.theme]" Source="{x:Static s:LocalizedText.Instance}"/>
         </MultiBinding>
        </TextBlock.Text>
       </TextBlock>
      </DataTemplate>
     </ComboBox.ItemTemplate>
    </ComboBox>
   </Grid>
   <Separator Margin="0,8"/>
   <Grid Style="{StaticResource SettingRow}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding [settings.quotePaths], Source={x:Static s:LocalizedText.Instance}}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    <ui:ToggleSwitch Cursor="Hand" OnContent="" OffContent="" Grid.Column="1" IsChecked="{Binding QuotePaths}" VerticalAlignment="Center"/>
   </Grid>
   <Grid Style="{StaticResource SettingRow}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding [settings.startAtLogin], Source={x:Static s:LocalizedText.Instance}}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    <ui:ToggleSwitch Cursor="Hand" OnContent="" OffContent="" Grid.Column="1" IsChecked="{Binding StartAtLogin}" VerticalAlignment="Center"/>
   </Grid>
   <Separator Margin="0,8,0,20"/>
   <ui:Button Cursor="Hand" Content="{Binding [settings.openLogs], Source={x:Static s:LocalizedText.Instance}}" Click="OpenLogs" HorizontalAlignment="Left"/>
   <TextBlock Text="{Binding Version}" Margin="0,24,0,0" Opacity="0.65"/>
  </StackPanel>
 </ScrollViewer>
 </Border>
</Page>
