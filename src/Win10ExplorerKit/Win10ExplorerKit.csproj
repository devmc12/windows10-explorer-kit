<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Win10ExplorerKit</RootNamespace>
    <AssemblyTitle>Win10 Explorer Kit</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="Localization\Locales\*.json" LogicalName="locales.%(Filename)%(Extension)" />
    <Content Include="Localization\Locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Win10ExplorerKit.Tests" />
    <InternalsVisibleTo Include="Win10ExplorerKit.HashHost.x86" />
    <InternalsVisibleTo Include="Win10ExplorerKit.HashHost.x64" />
  </ItemGroup>
</Project>
